dist/
build/
*.min.js
*.min.css
*.bundle.js
*.chunk.js

# ---- Docker ----
.dockerignore

# ---- Logs ----
*.log
logs/
log/
*.log.*
npm-debug.log*

# ---- Packet captures ----
*.pcap
*.pcapng
*.cap
*.dmp

# ---- SSL / Certificates ----
nginx/ssl/*.key
nginx/ssl/*.crt
nginx/ssl/*.pem
nginx/ssl/*.p12
nginx/ssl/*.pfx

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- IDEs ----
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ---- Temporary files ----
tmp/
temp/
*.tmp
*.bak
*.orig

# ---- Database dumps ----
*.sql.gz
*.dump
