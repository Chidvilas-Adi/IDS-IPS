# =============================================================
#  Database-Driven IDS/IPS  –  Example Environment Variables
#  Safe to commit. Copy to .env and replace every CHANGE_ME value first.
# =============================================================

# ----- PostgreSQL / TimescaleDB -----
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=idsips
POSTGRES_USER=idsips
POSTGRES_PASSWORD=CHANGE_ME

# ----- MongoDB -----
MONGO_URI=
MONGO_USER=idsips
MONGO_PASSWORD=CHANGE_ME
MONGO_DB=idsips

# ----- Redis -----
REDIS_URL=
REDIS_PASSWORD=CHANGE_ME

# ----- Flask Secret Keys -----
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
INITIAL_ADMIN_NAME=Your Name
INITIAL_ADMIN_EMAIL=admin@example.com
# Dashboard sign-in credentials. Username is fixed by the schema as `admin`.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=CHANGE_ME_generate_a_unique_password

# ----- Local API mapping -----
API_PORT=1234
WEB_PORT=8080
TLS_PORT=8443
TLS_DNS_NAME=localhost
TLS_IP_ADDRESS=127.0.0.1

# ----- Packet Capture -----
# Linux AF_PACKET interface; Windows currently selects the default-route IPv4.
NETWORK_INTERFACE=eth0

# ----- Email / SMTP (Gmail requires an app password) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=you@example.com

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Engine Tuning -----
ENGINE_POLL_INTERVAL=1
RULE_CACHE_TTL=60
MAX_PACKET_QUEUE=10000

# ----- Deception Layer -----
HONEYPOT_IP=10.0.0.254
SINKHOLE_IP=10.0.0.253
