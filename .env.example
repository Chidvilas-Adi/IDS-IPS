# =============================================================
#  Database-Driven IDS/IPS  –  Example Environment Variables
#  Safe to commit. Copy to .env and fill in real values.
# =============================================================

# ----- PostgreSQL / TimescaleDB -----
DATABASE_URL=postgresql://idsips:CHANGE_ME@postgres:5432/idsips
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=idsips
POSTGRES_USER=idsips
POSTGRES_PASSWORD=CHANGE_ME

# ----- MongoDB -----
MONGO_URI=mongodb://idsips:CHANGE_ME@mongodb:27017/idsips?authSource=admin
MONGO_DB=idsips

# ----- Redis -----
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# ----- Flask Secret Keys -----
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# ----- Packet Capture -----
NETWORK_INTERFACE=eth0

# ----- Threat Intelligence API Keys -----
ABUSEIPDB_API_KEY=<your_abuseipdb_api_key>
VIRUSTOTAL_API_KEY=<your_virustotal_api_key>
SHODAN_API_KEY=<your_shodan_api_key>
OTX_API_KEY=<your_otx_alienvault_api_key>

# ----- Email / SMTP Alerting -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=<your_smtp_password>

# ----- Slack Alerting -----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Engine Tuning -----
ENGINE_POLL_INTERVAL=1
RULE_CACHE_TTL=60
MAX_PACKET_QUEUE=10000

# ----- Deception Layer -----
HONEYPOT_IP=10.0.0.254
SINKHOLE_IP=10.0.0.253
